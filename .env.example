# ─── Telegram ────────────────────────────────
BOT_TOKEN=your_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# ─── Thresholds ──────────────────────────────
CPU_THRESHOLD=80
RAM_THRESHOLD=85
DISK_THRESHOLD=85
DISK_DELTA_ALERT_GB=5

# ─── Services to monitor ─────────────────────
SYSTEMD_SERVICES=nginx postgresql redis pgbouncer
PM2_PROCESSES=app api worker

# ─── TLS domains ─────────────────────────────
TLS_DOMAINS=ecesa.id www.ecesa.id
TLS_WARN_DAYS=14

# ─── Maintenance ─────────────────────────────
NGINX_MAINTENANCE_CONF=/etc/nginx/sites-available/maintenance
NGINX_NORMAL_CONF=/etc/nginx/sites-available/ecesa

# ─── Backup ──────────────────────────────────
BACKUP_DIR=/var/backups/ecesa
BACKUP_DB_NAME=ecesa_prod

# ─── Scheduling ──────────────────────────────
DAILY_REPORT_HOUR=8
REALERT_INTERVAL_HOURS=6

# ─── SSH Whitelist ────────────────────────────
TRUSTED_IPS=

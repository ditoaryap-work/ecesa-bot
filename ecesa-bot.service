[Unit]
Description=Ecesa VPS Monitor Bot
After=network.target

[Service]
Type=simple
User=vpsbot
WorkingDirectory=/opt/ecesa-bot
EnvironmentFile=/opt/ecesa-bot/.env
ExecStart=/opt/ecesa-bot/venv/bin/python3 bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ecesa-bot

# Security hardening
# NoNewPrivileges dinonaktifkan karena bot butuh sudo untuk nginx reload, systemctl, dll
PrivateTmp=yes
ReadWritePaths=/opt/ecesa-bot/state

[Install]
WantedBy=multi-user.target
